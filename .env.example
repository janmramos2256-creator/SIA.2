# Google Maps (optional – enables auto distance + map in BookingModal)
# Get a key: Google Cloud Console → APIs & Services → Credentials
# Enable: Maps JavaScript API + Distance Matrix API
# Restrict key by HTTP referrer (e.g. http://localhost:5173/*)
VITE_GOOGLE_MAPS_API_KEY=

# Origin address for delivery distance (shop / pickup point)
VITE_BUSINESS_ORIGIN=Manila, Metro Manila, Philippines

# Admin emails (comma-separated) for Firebase-protected admin dashboard
# VITE_ADMIN_EMAILS=admin@example.com
